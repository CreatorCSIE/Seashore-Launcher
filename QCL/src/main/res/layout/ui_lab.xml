<?xml version="1.0" encoding="utf-8"?>
<!-- ★ Phase 1.5 试点批：实验室页整体换装 FCL 组件层（FCL 1.3.4.4 fcllibrary）。
     替换规则（结构/ID 零变动，只动视图类与取色）：
       TextView        → FCLTextView   auto_text_tint（随主题亮暗自动黑/白）
       副标题 TextView → FCLTextView   use_theme_color（次要色 color2/color2Dark）
       卡片 LinearLayout → FCLLinearLayout（保留 qcl_button_gray 原灰底——
         ltColor 派生色太浅，tint 后与背景/壁纸同色层次消失，2026-11-05 判读）
       ImageView       → FCLImageView  auto_src_tint（图标 drawable 从 background 移到 src）
     页面根背景保持透明（launcher_ui_background=QCL 设计意图：透出 DynamicBackground 壁纸）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ui_lab"
    android:background="@color/launcher_ui_background"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_centerInParent="true"
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp"
                    android:singleLine="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_middle"
                    app:auto_text_tint="true"
                    android:text="@string/lab_ui_subtitle"/>

                <com.tungsten.fcllibrary.component.view.FCLLinearLayout
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:id="@+id/lab_card_color_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/qcl_button_gray"
                    android:orientation="horizontal">

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_outline_texture_black"
                        app:auto_src_tint="true"/>

                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.tungsten.fcllibrary.component.view.FCLTextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            app:auto_text_tint="true"
                            android:text="@string/lab_card_color_text_title"/>

                        <com.tungsten.fcllibrary.component.view.FCLTextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            app:use_theme_color="true"
                            android:text="@string/lab_card_color_text_sub"/>

                    </LinearLayout>

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:layout_marginStart="10dp"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_baseline_arrow_forward_black"
                        app:auto_src_tint="true"/>

                </com.tungsten.fcllibrary.component.view.FCLLinearLayout>

                <com.tungsten.fcllibrary.component.view.FCLLinearLayout
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:id="@+id/lab_card_seed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/qcl_button_gray"
                    android:orientation="horizontal">

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_baseline_earth_black"
                        app:auto_src_tint="true"/>

                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.tungsten.fcllibrary.component.view.FCLTextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            app:auto_text_tint="true"
                            android:text="@string/lab_card_seed_title"/>

                        <com.tungsten.fcllibrary.component.view.FCLTextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            app:use_theme_color="true"
                            android:text="@string/lab_card_seed_sub"/>

                    </LinearLayout>

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:layout_marginStart="10dp"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_baseline_arrow_forward_black"
                        app:auto_src_tint="true"/>

                </com.tungsten.fcllibrary.component.view.FCLLinearLayout>

                <com.tungsten.fcllibrary.component.view.FCLLinearLayout
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:id="@+id/lab_card_recipe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/qcl_button_gray"
                    android:orientation="horizontal">

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_outline_build_black"
                        app:auto_src_tint="true"/>

                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.tungsten.fcllibrary.component.view.FCLTextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            app:auto_text_tint="true"
                            android:text="@string/lab_card_recipe_title"/>

                        <com.tungsten.fcllibrary.component.view.FCLTextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            app:use_theme_color="true"
                            android:text="@string/lab_card_recipe_sub"/>

                    </LinearLayout>

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:layout_marginStart="10dp"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_baseline_arrow_forward_black"
                        app:auto_src_tint="true"/>

                </com.tungsten.fcllibrary.component.view.FCLLinearLayout>

                <com.tungsten.fcllibrary.component.view.FCLLinearLayout
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:id="@+id/lab_card_datapack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/qcl_button_gray"
                    android:orientation="horizontal">

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_outline_script_black"
                        app:auto_src_tint="true"/>

                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.tungsten.fcllibrary.component.view.FCLTextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            app:auto_text_tint="true"
                            android:text="@string/lab_card_datapack_title"/>

                        <com.tungsten.fcllibrary.component.view.FCLTextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            app:use_theme_color="true"
                            android:text="@string/lab_card_datapack_sub"/>

                    </LinearLayout>

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:layout_marginStart="10dp"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_baseline_arrow_forward_black"
                        app:auto_src_tint="true"/>

                </com.tungsten.fcllibrary.component.view.FCLLinearLayout>

                <com.tungsten.fcllibrary.component.view.FCLLinearLayout
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:id="@+id/lab_card_schematic_studio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/qcl_button_gray"
                    android:orientation="horizontal">

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_baseline_cube_black"
                        app:auto_src_tint="true"/>

                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.tungsten.fcllibrary.component.view.FCLTextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            app:auto_text_tint="true"
                            android:text="@string/lab_card_schematic_studio_title"/>

                        <com.tungsten.fcllibrary.component.view.FCLTextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            app:use_theme_color="true"
                            android:text="@string/lab_card_schematic_studio_sub"/>

                    </LinearLayout>

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:layout_marginStart="10dp"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_baseline_arrow_forward_black"
                        app:auto_src_tint="true"/>

                </com.tungsten.fcllibrary.component.view.FCLLinearLayout>

                <com.tungsten.fcllibrary.component.view.FCLLinearLayout
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:id="@+id/lab_card_schematic_download"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/qcl_button_gray"
                    android:orientation="horizontal">

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_outline_download_black"
                        app:auto_src_tint="true"/>

                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.tungsten.fcllibrary.component.view.FCLTextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            app:auto_text_tint="true"
                            android:text="@string/lab_card_schematic_download_title"/>

                        <com.tungsten.fcllibrary.component.view.FCLTextView
                            android:singleLine="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_middle"
                            app:use_theme_color="true"
                            android:text="@string/lab_card_schematic_download_sub"/>

                    </LinearLayout>

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:layout_marginStart="10dp"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_baseline_arrow_forward_black"
                        app:auto_src_tint="true"/>

                </com.tungsten.fcllibrary.component.view.FCLLinearLayout>

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</LinearLayout>
